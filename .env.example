# Copiá este archivo como .env y completá los valores.
# Clave para firmar las cookies de sesión. Generala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Contraseña de los usuarios de demostración que se crean al iniciar por primera vez
SEED_PASSWORD=

# Base de datos. Si no se define, se usa SQLite en instance/turnos.db
# DATABASE_URL=postgresql://usuario:password@host:5432/turnos

# 1 = modo debug (solo en desarrollo)
FLASK_DEBUG=0
